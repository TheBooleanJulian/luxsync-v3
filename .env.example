# Google Drive API v3 key — server-side only, never sent to the browser
DRIVE_API_KEY=

# Dropbox provider — optional, only needed if you want to support Dropbox
# shared-folder links alongside Drive. Create an app at
# https://www.dropbox.com/developers/apps with the sharing.read and
# files.metadata.read scopes, then generate a refresh token for it
# (OAuth2 authorization-code flow with token_access_type=offline).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Alternative to the three vars above for quick local testing: a token
# generated directly from the app console. Expires after a few hours.
DROPBOX_ACCESS_TOKEN=

# S3-compatible object storage for the image cache (Backblaze B2 / Cloudflare R2)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto

# Optional: Cloudflare-proxied base URL for cached images — when set, cache-hit
# image requests 302 straight to the CDN instead of being proxied through this server
CDN_BASE_URL=

# Optional: how long folder listings are cached, in seconds (default 600)
FOLDER_CACHE_TTL_SECONDS=600

# Admin dashboard at /admin (HTTP Basic auth, any username). Leave empty to disable it.
ADMIN_PASSWORD=
# Optional: salt for hashing visitor IPs in the download log (defaults to ADMIN_PASSWORD)
IP_HASH_SALT=
# Optional: where the download-log SQLite file lives (default ./data). On Zeabur,
# mount a persistent volume here or the log is wiped on every redeploy.
DATA_DIR=data
