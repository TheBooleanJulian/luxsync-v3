# Google Drive API v3 key — server-side only, never sent to the browser
DRIVE_API_KEY=

# S3-compatible object storage for the image cache (Backblaze B2 / Cloudflare R2)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto

# Optional: Cloudflare-proxied base URL for cached images — when set, cache-hit
# image requests 302 straight to the CDN instead of being proxied through this server
CDN_BASE_URL=

# Optional: how long folder listings are cached, in seconds (default 600)
FOLDER_CACHE_TTL_SECONDS=600
